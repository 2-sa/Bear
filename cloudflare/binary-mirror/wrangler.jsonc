{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "harbor-binary-mirror",
  "main": "src/index.js",
  "compatibility_date": "2026-07-27",
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "bear.7mood.net",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "r2_buckets": [
    {
      "binding": "BINARIES",
      "bucket_name": "harbor-build-assets"
    }
  ]
}
